# Copie este arquivo para ".env" e preencha com suas chaves reais.
# Nunca commite o arquivo ".env" (ele já está no .gitignore).

# Qual provedor de LLM usar: "anthropic" (Claude, pago) ou "google" (Gemini, camada gratuita)
LLM_PROVIDER=google

# --- Anthropic (Claude) ---
# Obtenha em https://console.anthropic.com/settings/keys (requer crédito pago)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Google (Gemini) ---
# Obtenha gratuitamente em https://aistudio.google.com/apikey
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-3.5-flash-lite

# Parâmetros de geração (usados por qualquer um dos dois provedores)
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
